+#!/usr/bin/env python3
+"""Stock Machine/Help lock-boundary tests; no emulator, graphics driver or network.
+Compiles the packaged production bodies, replacing only their SDK/header boundary.
+Run with --root <source-root> [--compiler g++|clang++] [--sanitize].
+"""
+import argparse, pathlib, re, subprocess, tempfile, shutil
+p=argparse.ArgumentParser()
+p.add_argument('--root', type=pathlib.Path, default=pathlib.Path(__file__).resolve().parents[2])
+p.add_argument('--compiler', default='g++')
+p.add_argument('--sanitize', action='store_true')
+p.add_argument('--dialog-platform', choices=['native','linux','windows','macos'], default='native')
+a=p.parse_args(); root=a.root.resolve(); ui=root/'ui/xui'
+def text(name): return (ui/name).read_text()
+def clean(s): return re.sub(r'^\s*#(?:include|pragma).*$', '', s, flags=re.M)
+def block(s, start, end): return s[s.index(start):s.index(end,s.index(start))]
+
+# Structural guards supplement the native stubs: nothing may move live guest
+# reads, mutations or BQL-sensitive callbacks into the host work queue.
+about=block(text('main-menu.cc'),'void MainMenuAboutView::Draw()', 'MainMenuTabButton::MainMenuTabButton')
+assert about.index('g_config.sys.files.bootrom_path') < about.index('HostUiUnlockedScope unlocked')
+assert 'g_config' not in about[about.index('HostUiUnlockedScope unlocked'):]
+assert 'wait_for(std::chrono::seconds(0))' in about
+assert 'result.generation == m_config_info_generation' in about
+compat=text('compat.cc')
+assert compat.index('xbe_headers.assign') < compat.index('HostUiUnlockedScope unlocked')
+token_commit = compat.index('if (token_changed)')
+unlocked = compat.index('HostUiUnlockedScope unlocked')
+assert 'xemu_settings_set_string' not in compat[unlocked:token_commit]
+assert 'send_job' not in compat and 'std::async' not in compat
+assert compat.index('report.Send()') > unlocked
+assert compat.index('report.Send()') < token_commit
+xc=(root/'ui/xemu.c').read_text()
+poll=block(xc,'static void poll_events(struct xemu_console *scon)', 'static void display_very_early_init')
+controller_update=poll.index('xemu_input_update_controllers();')
+final_unlock=poll.index('xemu_main_loop_unlock();', controller_update)
+host_actions=poll.index('xemu_hud_process_host_actions();')
+assert controller_update < final_unlock < host_actions
+assert 'xemu_main_loop_lock();\n                (*f)();\n                xemu_main_loop_unlock();' in text('misc.cc')
+assert text('reporting.cc').count('result_code = res;') == 1
+for f in ['main-menu.cc','menubar.cc','compat.cc','update.cc','widgets.cc']:
+    assert 'SDL_OpenURL(' not in text(f),f
+
+base=(root/'tests/unit/xemu-stock-ui-test-support.hh').read_text()
+# Header-only ABI substitution: the production bodies below are NOT reimplemented.
+parts=[base, clean(text('host-ui.hh')), clean(text('host-ui.cc')), clean(text('misc.cc'))]
+parts += [text('misc.hh')[text('misc.hh').index('static inline gchar *GetFileMD5Checksum'):]]
+parts += [block(text('main-menu.hh'),'class MainMenuAboutView','class MainMenuTabButton')]
+parts += [block(text('main-menu.cc'),'MainMenuAboutView::MainMenuAboutView()', 'MainMenuTabButton::MainMenuTabButton')]
+parts += [clean(text('reporting.hh'))]
+parts += [block(text('reporting.cc'),'CompatibilityReport::CompatibilityReport()', 'const std::string &CompatibilityReport::GetSerializedReport()')]
+parts += ['const char *compat_report_endpoint_url = "stub-only";\n']
+parts += [block(text('reporting.cc'),'bool CompatibilityReport::Send()', 'void CompatibilityReport::SetXbeData')]
+parts += [r"""
+const std::string &CompatibilityReport::GetSerializedReport() {
+    serialized = token + ":" + compat_comments + ":" + xbe_headers;
+    return serialized;
+}
+"""]
+parts += [clean(text('compat.hh')), clean(text('compat.cc'))]
+parts += [block(text('menubar.cc'),'#if defined(__APPLE__)', 'void ProcessKeyboardShortcuts')]
+parts += [text('menubar.cc')[text('menubar.cc').index('void ShowMainMenu()'):]]
+parts += [(root/'tests/unit/xemu-stock-ui-test-cases.hh').read_text()]
+with tempfile.TemporaryDirectory(prefix='xemu-stock-ui-') as d:
+    d=pathlib.Path(d); src=d/'test.cc'; src.write_text('\n'.join(parts))
+    exe=d/'test'
+    cmd=[a.compiler,'-std=c++17','-pthread','-Wall','-Wextra','-Werror',
+         '-Wno-unused-parameter','-Wno-missing-field-initializers',str(src),
+         '-l:libglib-2.0.so.0','-o',str(exe)]
+    if a.dialog_platform != 'native': cmd += ['-DSDL_PLATFORM_' + a.dialog_platform.upper()]
+    if a.sanitize: cmd += ['-O1','-g','-fno-omit-frame-pointer','-fsanitize=address,undefined']
+    else: cmd += ['-O2']
+    print('+', ' '.join(cmd), flush=True)
+    subprocess.run(cmd,check=True)
+    subprocess.run([str(exe),str(d)],check=True,timeout=30)
+print('PASS: stock Machine/Help source guards and exact-body native harness')
