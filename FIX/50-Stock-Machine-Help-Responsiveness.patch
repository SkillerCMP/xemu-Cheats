+// SPDX-License-Identifier: GPL-2.0-or-later
+static void wait_until(const std::function<bool()> &predicate) {
+    const auto end=std::chrono::steady_clock::now()+std::chrono::seconds(4);
+    while(!predicate()) {
+        assert(std::chrono::steady_clock::now()<end);
+        std::this_thread::yield();
+    }
+}
+static void about_frame(MainMenuAboutView &v) {
+    xemu_main_loop_lock();v.Draw();assert(locked);xemu_main_loop_unlock();
+}
+static void report_frame(CompatibilityReporter &v) {
+    xemu_main_loop_lock();v.Draw();assert(locked);xemu_main_loop_unlock();
+}
+int main(int argc,char **argv) {
+    assert(argc==2);std::string dir=argv[1];
+    xemu_main_loop_lock();
+    {HostUiUnlockedScope scope;host_only();}
+    need_lock();
+    try {HostUiUnlockedScope scope;throw std::runtime_error("test");}catch(const std::exception &){}
+    need_lock();xemu_main_loop_unlock();
+    puts("PASS: scoped release/restoration, including exception");
+
+    std::vector<int> order;
+    QueueHostUiAction([&]{host_only();order.push_back(1);QueueHostUiAction([&]{order.push_back(3);});});
+    QueueHostUiAction([&]{host_only();order.push_back(2);});
+    ProcessHostUiActions();assert((order==std::vector<int>{1,2}));
+    ProcessHostUiActions();assert((order==std::vector<int>{1,2,3}));
+    {std::string url="https://test.invalid/original";OpenHostUrl(url.c_str());url="changed";}
+    assert(urls.empty());ProcessHostUiActions();assert(urls.back()=="https://test.invalid/original");
+    puts("PASS: post-present FIFO, nested enqueue and URL ownership (no network)");
+
+    std::string file=dir+"/a.bin", newfile=dir+"/b.bin";
+    {std::ofstream out(file);out<<"abc";}
+    {std::ofstream out(newfile);out<<"hello";}
+    std::string selected;
+    {
+        std::string name="Images",pattern="iso;xiso",location=file;
+        SDL_DialogFileFilter filter{name.c_str(),pattern.c_str()};
+        xemu_main_loop_lock();
+        ShowOpenFileDialog(&filter,1,location.c_str(),[&](const char *p){need_lock();selected=p;});
+        ShowSaveFileDialog(&filter,1,location.c_str(),[&](const char *p){need_lock();selected=p;});
+        ShowOpenFolderDialog(dir.c_str(),[&](const char *p){need_lock();selected=p;});
+        xemu_main_loop_unlock();
+        name="changed";pattern="*";location="missing";
+    }
+    assert(dialogs.empty());ProcessHostUiActions();assert(dialogs.size()==3);
+    assert(std::string(dialogs[0].filters[0].name)=="Images");
+    assert(std::string(dialogs[0].filters[0].pattern)=="iso;xiso");
+#if defined(SDL_PLATFORM_LINUX)
+    assert(std::string(dialogs[0].path)==dir);
+#else
+    assert(std::string(dialogs[0].path)==file);
+#endif
+    const char *chosen[]={newfile.c_str(),nullptr};
+    dialogs[0].callback(dialogs[0].userdata,chosen,0);assert(selected==newfile);
+    dialogs[1].callback(dialogs[1].userdata,nullptr,0); // cancellation
+    dialogs[2].callback(dialogs[2].userdata,chosen,0);
+    dialogs.clear();
+    puts("PASS: open/save/folder dialog path/filter lifetime, cancellation and locked callbacks");
+
+    {g_autofree gchar *hash=GetFileMD5Checksum(file.c_str());assert(std::string(hash)=="900150983cd24fb0d6963f7d28e17f72");}
+    assert(!GetFileMD5Checksum(nullptr));assert(!GetFileMD5Checksum(""));
+    assert(!GetFileMD5Checksum((dir+"/missing").c_str()));
+    assert(!GetFileMD5Checksum(dir.c_str())); // read error, not a partial digest
+    std::string large=dir+"/large.bin";
+    {std::ofstream out(large,std::ios::binary);for(int i=0;i<100001;++i)out.put(char(i));}
+    GChecksum *ref=g_checksum_new(G_CHECKSUM_MD5);
+    {std::ifstream in(large,std::ios::binary);std::vector<unsigned char> bytes((std::istreambuf_iterator<char>(in)),{});g_checksum_update(ref,bytes.data(),bytes.size());}
+    {g_autofree gchar *hash=GetFileMD5Checksum(large.c_str());assert(std::string(hash)==g_checksum_get_string(ref));}
+    g_checksum_free(ref);
+    puts("PASS: real GLib MD5: known vector, multi-block file, missing/empty path and read error");
+
+    MainMenuAboutView about;
+    g_config.sys.files.bootrom_path=file.c_str();g_config.sys.files.flashrom_path=file.c_str();
+    hold_hash=true;hash_started=false;hash_reads=0;
+    about_frame(about);wait_until([]{return hash_started.load();});
+    assert(fields["##config_info"]=="Loading ROM hashes...");
+    for(int i=0;i<5;++i)about_frame(about);
+    assert(hash_reads==1); // still exactly one outstanding job
+    xemu_main_loop_lock();
+    g_config.sys.files.bootrom_path=newfile.c_str();g_config.sys.files.flashrom_path=newfile.c_str();
+    about.UpdateConfigInfoText();xemu_main_loop_unlock();
+    about_frame(about);assert(hash_reads==1);
+    hold_hash=false;
+    wait_until([&]{about_frame(about);return fields["##config_info"].find("5d41402abc4b2a76b9719d911017c592")!=std::string::npos;});
+    assert(fields["##config_info"].find("900150983cd24fb0d6963f7d28e17f72")==std::string::npos);
+    auto reads=hash_reads.load();for(int i=0;i<25;++i)about_frame(about);assert(hash_reads==reads);
+    puts("PASS: About never waits for hashing; one job, stale-result rejection and warm-cache reuse");
+
+    std::thread guest([]{
+        while(!guest_stop){xemu_main_loop_lock();++guest_steps;xemu_main_loop_unlock();std::this_thread::yield();}
+    });
+    visible_menu="Machine";clicked.clear();game_progress_check=true;actions.clear();
+    xemu_main_loop_lock();ShowMainMenu();need_lock();xemu_main_loop_unlock();
+    assert(actions.empty());
+    const std::vector<std::pair<std::string,std::string>> commands={
+        {"Pause","pause"},{"Screenshot","screenshot"},{"Create Snapshot","snapshot"},
+        {"Load 'Alpha'","load0"},{"Save 'Beta'","save2"},{"Eject Disc","eject"},
+        {"Load Disc...","load-disc"},{"Reset","reset"},{"Exit","exit"}};
+    for(auto &entry:commands){clicked=entry.first;xemu_main_loop_lock();ShowMainMenu();xemu_main_loop_unlock();assert(actions.back()==entry.second);}
+    auto count=actions.size();clicked="Load F6 (Unbound)";
+    xemu_main_loop_lock();ShowMainMenu();xemu_main_loop_unlock();assert(actions.size()==count);
+    visible_menu="Help";clicked="Help";game_progress_check=true;
+    xemu_main_loop_lock();ShowMainMenu();xemu_main_loop_unlock();ProcessHostUiActions();
+    assert(urls.back()=="https://xemu.app/docs/getting-started/");
+    guest_stop=true;guest.join();visible_menu.clear();clicked.clear();
+    puts("PASS: Machine/Help draw permits simulated guest progress; commands still locked and unbound slots disabled");
+
+    CompatibilityReporter reporter;
+    reporter.is_open=true;window_appearing=true;clicked.clear();send_count=0;
+    on_unlock=[]{std::fill(std::begin(guest_header_data),std::end(guest_header_data),9);};
+    report_frame(reporter);
+    assert(reporter.report.xbe_headers=="AQIDBA==");
+    assert(send_count==0); // Opening the window must never submit a report.
+    guest_stop=false;
+    std::thread report_guest([]{
+        while(!guest_stop){xemu_main_loop_lock();++guest_steps;xemu_main_loop_unlock();std::this_thread::yield();}
+    });
+    auto caller=std::this_thread::get_id();
+    http_probe=[&]{
+        assert(std::this_thread::get_id()==caller);host_only();
+        auto before=guest_steps.load();
+        wait_until([&]{return guest_steps.load()>before;});
+    };
+    clicked="Send";report_frame(reporter);
+    guest_stop=true;report_guest.join();http_probe=nullptr;
+    assert(sent_payload.find("AQIDBA==")!=std::string::npos);
+    assert(send_count==1 && reporter.send_result && !reporter.is_open);
+    assert(reporter.report.GetResultCode()==200);
+    clicked.clear();report_frame(reporter);assert(send_count==1);
+    puts("PASS: report header snapshot, no auto-send, same-thread HTTP outside guest lock (stub only)");
+
+    reporter.is_open=true;window_appearing=true;http_status=403;clicked="Send";
+    report_frame(reporter);
+    assert(!reporter.send_result && reporter.is_open && reporter.report.GetResultCode()==403);
+    clicked.clear();entered_token="new-token";report_frame(reporter);assert(committed_token=="new-token");
+    have_xbe=false;window_appearing=true;report_frame(reporter);assert(!reporter.is_xbe_identified);
+    puts("PASS: HTTP failure/status handling, synchronized token commit and missing-XBE early return");
+    puts("PASS: all exact-production-body stock UI tests");
+}
