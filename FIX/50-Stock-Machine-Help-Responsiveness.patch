+// SPDX-License-Identifier: GPL-2.0-or-later
+// SDK boundary stubs only; tested production function bodies are inserted verbatim.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
