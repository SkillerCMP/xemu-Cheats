+#include <thread>
+#include <utility>
+#include <vector>
+
+using gchar = char;
+using guchar = unsigned char;
+struct GChecksum;
+constexpr int G_CHECKSUM_MD5 = 0;
+extern "C" {
+GChecksum *g_checksum_new(int);
+void g_checksum_update(GChecksum *, const unsigned char *, long);
+const char *g_checksum_get_string(GChecksum *);
+void g_checksum_free(GChecksum *);
+char *g_strdup(const char *);
+char *g_strdup_printf(const char *, ...);
+void g_free(void *);
+char *g_base64_encode(const unsigned char *, size_t);
+}
+static void cleanup_gfree(void *p) { g_free(*static_cast<void **>(p)); }
+#define g_autofree __attribute__((cleanup(cleanup_gfree)))
+static thread_local bool locked = false;
+static std::mutex machine_mutex;
+static std::atomic<unsigned> guest_steps{0};
+static std::atomic<bool> guest_stop{false};
+static std::function<void()> on_unlock;
+void xemu_main_loop_lock() { assert(!locked); machine_mutex.lock(); locked = true; }
+void xemu_main_loop_unlock() {
+    assert(locked); locked = false; machine_mutex.unlock();
+    if (on_unlock) { auto f = std::move(on_unlock); on_unlock = {}; f(); }
+}
+static void need_lock() { assert(locked); }
+static void host_only() { assert(!locked); }
+static std::atomic<bool> hold_hash{false}, hash_started{false};
+static std::atomic<int> hash_reads{0};
+static FILE *qemu_fopen(const char *p, const char *m) {
+    host_only(); ++hash_reads; hash_started = true;
+    while (hold_hash) std::this_thread::yield();
+    return fopen(p,m);
+}
+using FileDialogCallback = std::function<void(const char *)>;
+struct SDL_Window {};
+struct SDL_DialogFileFilter {const char *name; const char *pattern;};
+using SDL_DialogFileCallback = void (*)(void *,const char *const *,int);
+static SDL_Window window;
+SDL_Window *xemu_get_window() { return &window; }
+struct MockDialog {SDL_DialogFileCallback callback; void *userdata; const SDL_DialogFileFilter *filters; int count; const char *path;};
+static std::vector<MockDialog> dialogs;
+void SDL_ShowOpenFileDialog(SDL_DialogFileCallback cb,void *data,SDL_Window *,const SDL_DialogFileFilter *f,int n,const char *path,bool) {
+    host_only(); dialogs.push_back({cb,data,f,n,path});
+}
+void SDL_ShowSaveFileDialog(SDL_DialogFileCallback cb,void *data,SDL_Window *,const SDL_DialogFileFilter *f,int n,const char *path) {
+    host_only(); dialogs.push_back({cb,data,f,n,path});
+}
+void SDL_ShowOpenFolderDialog(SDL_DialogFileCallback cb,void *data,SDL_Window *,const char *path,bool) {
+    host_only(); dialogs.push_back({cb,data,nullptr,0,path});
+}
+bool SDL_RunOnMainThread(void (*f)(void *),void *d,bool) {host_only();f(d);return true;}
+static std::vector<std::string> urls;
+bool SDL_OpenURL(const char *u) {host_only();urls.emplace_back(u);return true;}
+const char *SDL_GetPlatform() {return "test";}
+const char *xemu_get_cpu_info() {return "stub CPU";}
+const char *xemu_get_os_info() {return "stub OS";}
+constexpr int GL_VENDOR=1, GL_RENDERER=2, GL_VERSION=3, GL_SHADING_LANGUAGE_VERSION=4;
+const unsigned char *glGetString(int) {host_only();return reinterpret_cast<const unsigned char *>("stub GL");}
+static const char *xemu_version="test", *xemu_commit="test", *xemu_date="test";
+struct {float m_scale=1;} g_viewport_mgr;
+struct {void *m_fixed_width_font=nullptr;} g_font_mgr;
+struct Config {
+    struct {struct {const char *bootrom_path=""; const char *flashrom_path="";} files;} sys;
+    struct {const char *user_token="token";} general;
+    struct {int renderer=1,filtering=0; struct {bool auto_scale=false;int scale=1,fit=0,aspect_ratio=0;} ui;} display;
+} g_config;
+static std::string committed_token;
+void xemu_settings_set_string(const char **p,const char *s) {need_lock(); committed_token=s;*p=committed_token.c_str();}
+struct Error {};
+struct xbe {uint8_t *headers; unsigned headers_len;};
+static uint8_t guest_header_data[]={1,2,3,4};
+static xbe guest_xbe{guest_header_data,sizeof(guest_header_data)};
+static bool have_xbe=true;
+xbe *xemu_get_xbe_info() {need_lock(); return have_xbe ? &guest_xbe : nullptr;}
+class MainMenuTabView {public:virtual ~MainMenuTabView()=default;virtual void Draw()=0;};
+struct ImVec2 {float x,y;ImVec2(float x=0,float y=0):x(x),y(y){}};
+constexpr int ImGuiWindowFlags_NoCollapse=1,ImGuiWindowFlags_AlwaysAutoResize=2,ImGuiInputTextFlags_ReadOnly=4;
+static std::string visible_menu, clicked, entered_token;
+static bool window_appearing=true;
+static int disabled_depth=0;
+static std::vector<std::string> menu_stack;
+static std::vector<std::string> seen_labels;
+static std::map<std::string,std::string> fields;
+static bool game_progress_check=false;
+namespace ImGui {
+struct Style {ImVec2 WindowPadding{1,1},ItemSpacing{1,1};};
+static Style style;
+Style &GetStyle() {return style;}
+void check() {
+    if (!menu_stack.empty() && (menu_stack.front()=="Machine" || menu_stack.front()=="Help")) host_only();
+}
+bool BeginMainMenuBar() {return true;}
+void EndMainMenuBar() {}
+bool BeginMenu(const char *s) {
+    check();
+    if (menu_stack.empty()) {if(visible_menu!=s)return false; menu_stack.emplace_back(s);return true;}
+    if(std::string(s)=="Snapshot") {menu_stack.emplace_back(s);return true;}
+    return false;
+}
+void EndMenu() {check();menu_stack.pop_back();}
+bool MenuItem(const char *s,const char * = nullptr,bool=false,bool enabled=true) {
+    check();seen_labels.emplace_back(s);
+    if(game_progress_check && !menu_stack.empty()) {
+        auto before=guest_steps.load();
+        auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(2);
+        while(guest_steps==before && std::chrono::steady_clock::now()<deadline) std::this_thread::yield();
+        assert(guest_steps>before);game_progress_check=false;
+    }
+    bool yes=enabled && clicked==s; if(yes)clicked.clear();return yes;
+}
+bool MenuItem(const char *s,const char *shortcut,bool *v) {bool yes=MenuItem(s,shortcut,*v,true);if(yes)*v=!*v;return yes;}
+void Separator(){check();}
+bool Combo(const char *,int *,const char *) {check();return false;}
+void SameLine(){check();}
+float GetWindowHeight(){return 24;}
+void SetNextWindowContentSize(ImVec2){}
+bool Begin(const char *,bool *,int){return true;}
+void End(){}
+bool IsWindowAppearing(){bool b=window_appearing;window_appearing=false;return b;}
+void TextWrapped(const char *,...){host_only();}
+void Text(const char *,...){host_only();}
+void TextUnformatted(const char *){host_only();}
+void Dummy(ImVec2){host_only();}
+void Columns(int,const char * = "",bool=false){host_only();}
+void SetColumnWidth(int,float){host_only();}
+float GetWindowWidth(){return 550;}
+float GetColumnWidth(){return 250;}
+void NextColumn(){host_only();}
+void SetNextItemWidth(float){host_only();}
+void PushFont(void *){host_only();}
+void PopFont(){host_only();}
+bool InputText(const char *,char *buf,size_t size,int) {
+    host_only();if(entered_token.empty() || disabled_depth)return false;
+    snprintf(buf,size,"%s",entered_token.c_str());entered_token.clear();return true;
+}
+bool InputTextMultiline(const char *id,char *buf,size_t,ImVec2,int) {host_only(); fields[id]=buf;return false;}
+float GetTextLineHeight(){return 12;}
+bool SmallButton(const char *s){host_only();return MenuItem(s);}
+bool TreeNode(const char *){host_only();return true;}
+void TreePop(){host_only();}
+void SetCursorPosX(float){host_only();}
