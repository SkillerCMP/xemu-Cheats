diff --git a/ui/xui/host-ui.cc b/ui/xui/host-ui.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7daf50c89a42e1dd636923cbe4412c8316d4f4d0
--- /dev/null
+++ b/ui/xui/host-ui.cc
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "common.hh"
+#include "host-ui.hh"
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace {
+std::vector<std::function<void()>> host_actions;
+}
+
+void QueueHostUiAction(std::function<void()> action)
+{
+    host_actions.push_back(std::move(action));
+}
+
+void ProcessHostUiActions()
+{
+    // Defer nested actions to the next frame.
+    std::vector<std::function<void()>> pending;
+    pending.swap(host_actions);
+    for (auto &action : pending) {
+        action();
+    }
+}
+
+void OpenHostUrl(const char *url)
+{
+    if (url && *url) {
+        QueueHostUiAction([url = std::string(url)] { SDL_OpenURL(url.c_str()); });
+    }
+}
