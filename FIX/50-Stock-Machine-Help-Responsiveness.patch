+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <functional>
+#include "xemu-hud.h"
+
+// UI-only scope entered with the main-loop lock held.
+// Do not retain live guest/device pointers.
+class HostUiUnlockedScope {
+public:
+    HostUiUnlockedScope() { xemu_main_loop_unlock(); }
+    ~HostUiUnlockedScope() { xemu_main_loop_lock(); }
+    HostUiUnlockedScope(const HostUiUnlockedScope &) = delete;
+    HostUiUnlockedScope &operator=(const HostUiUnlockedScope &) = delete;
+};
+
+// Host actions run post-present outside emulator locks.
+void QueueHostUiAction(std::function<void()> action);
+void ProcessHostUiActions();
+void OpenHostUrl(const char *url);
