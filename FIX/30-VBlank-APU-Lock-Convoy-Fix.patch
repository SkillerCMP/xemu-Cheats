 {
     assert(v < MCPX_HW_MAX_VOICES);
-    qemu_mutex_lock(&d->lock);
 
-    uint64_t mask = 1LL << (v % 64);
+    /*
+     * NV1BA0_PIO_VOICE_LOCK is guest MMIO and must not block the vCPU behind
+     * a whole APU frame.  The frame/worker side already observes voice_locked
+     * with qatomic_read(), so update the same bit atomically instead of taking
+     * d->lock.  This keeps the MMIO write bounded even when se_frame() owns the
+     * APU mutex for several milliseconds.
+     *
+     * The condition signal is intentionally lock-free too.  A missed wake is
+     * harmless because voice_work_dispatch() uses a 1 ms timed wait; the
+     * atomic bit remains authoritative and will be observed on the next check.
+     */
+    uint64_t mask = 1ULL << (v % 64);
     if (lock) {
-        d->vp.voice_locked[v / 64] |= mask;
+        qatomic_or(&d->vp.voice_locked[v / 64], mask);
     } else {
-        d->vp.voice_locked[v / 64] &= ~mask;
+        qatomic_and(&d->vp.voice_locked[v / 64], ~mask);
     }
 
     qemu_cond_signal(&d->cond);
-    qemu_mutex_unlock(&d->lock);
 }
 
