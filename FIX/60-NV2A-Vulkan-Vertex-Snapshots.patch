+            a[j].stride = 1 + rnd() % 137;
+            a[j].width = widths[rnd() % 8];
+            a[j].location = 15 - j;
+        }
+        size_t limit = 16 + rnd() % (SPACE - 16);
+        size_t required = 0;
+        for (unsigned j = 0; j < n; j++) {
