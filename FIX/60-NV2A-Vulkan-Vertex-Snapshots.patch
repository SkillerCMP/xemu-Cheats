diff --git a/hw/xbox/nv2a/pgraph/vk/vertex.c b/hw/xbox/nv2a/pgraph/vk/vertex.c
--- a/hw/xbox/nv2a/pgraph/vk/vertex.c
+++ b/hw/xbox/nv2a/pgraph/vk/vertex.c
@@ -350 +350,237 @@
 }
+
+/* Fix 60: immutable per-draw RAM vertices in the existing inline arena.
+ *
+ * This is buffer versioning, not a fence bypass. Existing vertex RAM updates
+ * and their uploaded-page fence remain untouched for fallback draws. Snapshots
+ * do not clear DIRTY_MEMORY_NV2A; an enabled fallback nevertheless refreshes all
+ * requested RAM ranges because surface handling can share that dirty client.
+ *
+ * The arena is transferred by sync_staging_buffer() before the main command
+ * buffer, with the existing transfer -> vertex-input dependency and semaphore.
+ * A wrap uses pgraph_vk_finish() before reuse, including its original fence wait.
+ */
+
+static uint32_t vertex_snapshot_format_width(VkFormat format)
+{
+    switch (format) {
+    case VK_FORMAT_R8_UNORM: return 1;
+    case VK_FORMAT_R8G8_UNORM:
+    case VK_FORMAT_R16_SNORM:
+    case VK_FORMAT_R16_SSCALED: return 2;
+    case VK_FORMAT_R8G8B8_UNORM: return 3;
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_R16G16_SNORM:
+    case VK_FORMAT_R16G16_SSCALED:
+    case VK_FORMAT_R32_SFLOAT:
+    case VK_FORMAT_R32_SINT: return 4;
+    case VK_FORMAT_R16G16B16_SNORM:
+    case VK_FORMAT_R16G16B16_SSCALED: return 6;
+    case VK_FORMAT_R16G16B16A16_SNORM:
+    case VK_FORMAT_R16G16B16A16_SSCALED:
+    case VK_FORMAT_R32G32_SFLOAT: return 8;
+    case VK_FORMAT_R32G32B32_SFLOAT: return 12;
+    case VK_FORMAT_R32G32B32A32_SFLOAT: return 16;
+    default: return 0;
+    }
+}
+
+/* Validate/merge before making calls with side effects. Download dependencies
+ * include stock page-rounded requirements and the exact fetched byte spans
+ * (which can extend beyond stride for overlapping attribute layouts).
+ */
+static bool vertex_snapshot_add_range(MemorySyncRequirement *ranges,
+                                      size_t *count, hwaddr addr, hwaddr size,
+                                      uint64_t ram_size)
+{
+    if (addr > ram_size || size > ram_size - addr || *count >= 32) {
+        return false;
+    }
+    if (!size) {
+        return true;
+    }
+    hwaddr first = addr & TARGET_PAGE_MASK;
+    hwaddr end = addr + size;
+    hwaddr padding = (TARGET_PAGE_SIZE - end % TARGET_PAGE_SIZE) % TARGET_PAGE_SIZE;
+    if (padding > ram_size - end) {
+        return false;
+    }
+    end += padding;
+    size_t pos = (*count)++;
+    while (pos && ranges[pos - 1].addr > first) {
+        ranges[pos] = ranges[pos - 1];
+        pos--;
+    }
+    ranges[pos] = (MemorySyncRequirement){ .addr = first, .size = end - first };
+    return true;
+}
+
+bool pgraph_vk_prepare_vertex_snapshot(NV2AState *d)
+{
+    PGRAPHState *pg = &d->pgraph;
+    PGRAPHVkState *r = pg->vk_renderer_state;
+    StorageBuffer *buffer = &r->storage_buffers[BUFFER_VERTEX_INLINE_STAGING];
+    VertexSnapshotAttribute attrs[NV2A_VK_SNAPSHOT_ATTRS];
+    VertexSnapshot plan;
+    MemorySyncRequirement ranges[32];
+    size_t nranges = 0, start;
+    uint32_t first = UINT32_MAX, last = 0;
+    uint64_t ram_size = memory_region_size(d->vram);
+    r->vertex_snapshot.active = false;
+
+    if (!r->vertex_snapshots_enabled || !r->vertex_snapshot_scratch ||
+        !buffer->mapped ||
+        r->num_active_vertex_binding_descriptions <= 0 ||
+        r->num_active_vertex_binding_descriptions > NV2A_VK_SNAPSHOT_ATTRS ||
+        r->num_active_vertex_attribute_descriptions !=
+            r->num_active_vertex_binding_descriptions ||
+        r->num_vertex_ram_buffer_syncs > NV2A_VERTEXSHADER_ATTRIBUTES ||
+        pg->draw_arrays_length > ARRAY_SIZE(pg->draw_arrays_start) ||
+        pg->inline_elements_length > ARRAY_SIZE(pg->inline_elements)) {
+        return false;
+    }
+    if (pg->draw_arrays_length) {
+        for (unsigned int i = 0; i < pg->draw_arrays_length; i++) {
+            if (pg->draw_arrays_start[i] < 0 || pg->draw_arrays_count[i] <= 0) {
+                return false;
+            }
+            uint64_t end = (uint64_t)(uint32_t)pg->draw_arrays_start[i] +
+                           (uint32_t)pg->draw_arrays_count[i];
+            if (end > UINT32_MAX) {
+                return false;
+            }
+            first = MIN(first, (uint32_t)pg->draw_arrays_start[i]);
+            last = MAX(last, (uint32_t)end - 1);
+        }
+    } else if (pg->inline_elements_length) {
+        for (unsigned int i = 0; i < pg->inline_elements_length; i++) {
+            first = MIN(first, pg->inline_elements[i]);
+            last = MAX(last, pg->inline_elements[i]);
+        }
+    } else {
+        return false;
+    }
+    for (int i = 0; i < r->num_active_vertex_binding_descriptions; i++) {
+        const VkVertexInputAttributeDescription *a = &r->vertex_attribute_descriptions[i];
+        const VkVertexInputBindingDescription *b = &r->vertex_binding_descriptions[i];
+        if (a->location >= NV2A_VK_SNAPSHOT_ATTRS || a->binding != (uint32_t)i ||
+            b->binding != (uint32_t)i || a->offset != 0 ||
+            b->inputRate != VK_VERTEX_INPUT_RATE_VERTEX) {
+            return false;
+        }
+        attrs[i] = (VertexSnapshotAttribute){
+            .source = r->vertex_attribute_offsets[a->location],
+            .stride = b->stride,
+            .width = vertex_snapshot_format_width(a->format),
+            .location = a->location,
+        };
+    }
+    if (!nv2a_vk_snapshot_plan(&plan, attrs,
+                              r->num_active_vertex_binding_descriptions,
+                              first, last, ram_size, buffer->buffer_size)) {
+        return false;
+    }
+    for (size_t i = 0; i < r->num_vertex_ram_buffer_syncs; i++) {
+        MemorySyncRequirement s = r->vertex_ram_buffer_syncs[i];
+        if (!vertex_snapshot_add_range(ranges, &nranges, s.addr, s.size, ram_size)) {
+            return false;
+        }
+    }
+    for (uint32_t i = 0; i < plan.count; i++) {
+        const VertexSnapshotAttribute *a = &plan.attributes[i];
+        uint64_t addr = a->source + (uint64_t)first * a->stride;
+        uint64_t size = (uint64_t)(last - first) * a->stride + a->width;
+        if (!vertex_snapshot_add_range(ranges, &nranges, addr, size, ram_size)) {
+            return false;
+        }
+    }
+    size_t merged = 0;
+    for (size_t i = 0; i < nranges; i++) {
+        if (merged && ranges[i].addr <= ranges[merged - 1].addr + ranges[merged - 1].size) {
+            hwaddr end = MAX(ranges[i].addr + ranges[i].size,
+                             ranges[merged - 1].addr + ranges[merged - 1].size);
+            ranges[merged - 1].size = end - ranges[merged - 1].addr;
+        } else {
+            ranges[merged++] = ranges[i];
+        }
+    }
+    /* No allocation/copy/stride mutation has happened before validation. */
+    for (size_t i = 0; i < merged; i++) {
+        pgraph_vk_download_surfaces_in_range_if_dirty(pg, ranges[i].addr, ranges[i].size);
+    }
+    if (!nv2a_vk_snapshot_space(buffer->buffer_offset, buffer->buffer_size,
+                               plan.bytes, &start)) {
+        pgraph_vk_finish(pg, VK_FINISH_REASON_NEED_BUFFER_SPACE);
+    }
+    /* Do not overwrite old allocations even if a future finish implementation
+     * does not reclaim this arena. Fall back to the original synchronized path.
+     */
+    if (!nv2a_vk_snapshot_space(buffer->buffer_offset, buffer->buffer_size,
+                               plan.bytes, &start)) {
+        return false;
+    }
+    /* Capture before expensive pipeline/descriptor helpers, at the same
+     * synchronization point as the original RAM mirror update. The CPU-only
+     * scratch is not referenced by any GPU work and survives arena resets. */
+    nv2a_vk_snapshot_copy(&plan, d->vram_ptr, r->vertex_snapshot_scratch);
+    for (uint32_t i = 0; i < plan.count; i++) {
+        r->vertex_binding_descriptions[i].stride = plan.attributes[i].width;
+    }
+    r->vertex_snapshot = plan;
+    r->num_vertex_ram_buffer_syncs = 0;
+    return true;
+}
+
+void pgraph_vk_copy_vertex_snapshot(NV2AState *d)
+{
+    PGRAPHVkState *r = d->pgraph.vk_renderer_state;
+    StorageBuffer *buffer = &r->storage_buffers[BUFFER_VERTEX_INLINE_STAGING];
+    VertexSnapshot *plan = &r->vertex_snapshot;
+    size_t start = 0;
+    /* Called after begin_pre_draw: descriptor/framebuffer helpers may have
+     * finished and reset the arena since preparation. Re-read the cursor now.
+     * No finish is allowed here; the current draw has not begun yet.
+     */
+    bool fits = nv2a_vk_snapshot_space(buffer->buffer_offset, buffer->buffer_size,
+                                       plan->bytes, &start);
+    if (!plan->active || !fits || !buffer->mapped) {
+        /* Keep the bounds check effective even in NDEBUG builds. */
+        fprintf(stderr, "Fix 60: vertex snapshot reservation lost\n");
+        abort();
+    }
+    memcpy(buffer->mapped + start, r->vertex_snapshot_scratch, plan->bytes);
+    for (uint32_t i = 0; i < plan->count; i++) {
+        const VertexSnapshotAttribute *a = &plan->attributes[i];
+        r->vertex_attribute_offsets[a->location] = start + a->offset;
+    }
+    buffer->buffer_offset = start + plan->bytes;
+    /* RANDOM host access does not imply HOST_COHERENT. Explicitly flush the
+     * snapshot range before the existing auxiliary transfer submission.
+     */
+    VK_CHECK(vmaFlushAllocation(r->allocator, buffer->allocation, start, plan->bytes));
+    nv2a_profile_inc_counter(NV2A_PROF_GEOM_BUFFER_UPDATE_3);
+    r->vertex_snapshot_draws++;
+    r->vertex_snapshot_bytes += plan->bytes;
+    plan->active = false;
+}
+
+/* Fallback ownership handoff: snapshots deliberately did not update the RAM
+ * mirror. Re-dirty only the upcoming draw's requested ranges, so the unchanged
+ * stock dirty test/update path refreshes them even if surface handling consumed
+ * that dirty client's flags. No guest bytes or other dirty clients are changed.
+ */
+void pgraph_vk_invalidate_vertex_snapshot_mirror(NV2AState *d)
+{
+    PGRAPHVkState *r = d->pgraph.vk_renderer_state;
+    uint64_t ram_size = memory_region_size(d->vram);
+    if (r->num_vertex_ram_buffer_syncs > ARRAY_SIZE(r->vertex_ram_buffer_syncs)) {
+        return;
+    }
+    for (size_t i = 0; i < r->num_vertex_ram_buffer_syncs; i++) {
+        const MemorySyncRequirement *s = &r->vertex_ram_buffer_syncs[i];
+        if (s->size && s->addr <= ram_size && s->size <= ram_size - s->addr) {
+            memory_region_set_client_dirty(d->vram, s->addr, s->size,
+                                           DIRTY_MEMORY_NV2A);
+        }
+    }
+}
