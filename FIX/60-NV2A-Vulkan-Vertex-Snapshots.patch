diff --git a/hw/xbox/nv2a/pgraph/vk/vertex-snapshot.h b/hw/xbox/nv2a/pgraph/vk/vertex-snapshot.h
new file mode 100644
--- /dev/null
+++ b/hw/xbox/nv2a/pgraph/vk/vertex-snapshot.h
@@ -0,0 +1,143 @@
+/*
+ * Bounded, append-only vertex snapshots for the NV2A Vulkan renderer.
+ * SPDX-License-Identifier: LGPL-2.0-or-later
+ *
+ * Pure byte/layout helpers: no Vulkan, guest writes, locks, or allocation.
+ * Keep vertex indices unchanged, including gl_VertexIndex. Unused prefixes
+ * are reserved but never read from guest RAM or fetched by the draw.
+ */
+#ifndef HW_XBOX_NV2A_PGRAPH_VK_VERTEX_SNAPSHOT_H
+#define HW_XBOX_NV2A_PGRAPH_VK_VERTEX_SNAPSHOT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define NV2A_VK_SNAPSHOT_ATTRS 16
+#define NV2A_VK_SNAPSHOT_LIMIT (8u * 1024u * 1024u)
+#define NV2A_VK_SNAPSHOT_ALIGNMENT 16u
+#define NV2A_VK_SNAPSHOT_PREFIX_LIMIT (64u * 1024u)
+
+typedef struct VertexSnapshotAttribute {
+    uint64_t source;
+    uint32_t stride;
+    uint32_t width;
+    uint32_t location;
+    size_t offset;
+} VertexSnapshotAttribute;
+
+typedef struct VertexSnapshot {
+    bool active;
+    uint32_t first;
+    uint32_t last;
+    uint32_t count;
+    size_t bytes;
+    VertexSnapshotAttribute attributes[NV2A_VK_SNAPSHOT_ATTRS];
+} VertexSnapshot;
+
+/* An unsuccessful plan leaves no partially usable plan behind. */
+static inline bool nv2a_vk_snapshot_plan(
+    VertexSnapshot *out, const VertexSnapshotAttribute *attributes,
+    uint32_t count, uint32_t first, uint32_t last, uint64_t ram_size,
+    size_t capacity)
+{
+    VertexSnapshot plan = { 0 };
+    uint32_t locations = 0;
+    uint64_t useful_bytes = 0;
+    *out = plan;
+    if (!attributes || !count || count > NV2A_VK_SNAPSHOT_ATTRS || first > last ||
+        last == UINT32_MAX || ram_size > SIZE_MAX) {
+        return false;
+    }
+    if (capacity > NV2A_VK_SNAPSHOT_LIMIT) {
+        capacity = NV2A_VK_SNAPSHOT_LIMIT;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        VertexSnapshotAttribute a = attributes[i];
+        if (!a.width || a.width > 16 || !a.stride ||
+            a.location >= NV2A_VK_SNAPSHOT_ATTRS ||
+            (locations & (1u << a.location)) || a.source > ram_size) {
+            return false;
+        }
+        /* Products fit uint64_t: both factors are uint32_t. */
+        uint64_t last_offset = (uint64_t)last * a.stride;
+        if (last_offset > ram_size - a.source ||
+            a.width > ram_size - a.source - last_offset) {
+            return false;
+        }
+        uint64_t bytes = ((uint64_t)last + 1) * a.width;
+        size_t padding = (NV2A_VK_SNAPSHOT_ALIGNMENT -
+                          plan.bytes % NV2A_VK_SNAPSHOT_ALIGNMENT) %
+                         NV2A_VK_SNAPSHOT_ALIGNMENT;
+        if (plan.bytes > capacity || padding > capacity - plan.bytes ||
+            bytes > capacity - plan.bytes - padding) {
+            return false;
+        }
+        a.offset = plan.bytes + padding;
+        plan.attributes[i] = a;
+        plan.bytes = a.offset + (size_t)bytes;
+        locations |= 1u << a.location;
+        useful_bytes += ((uint64_t)last - first + 1) * a.width;
+    }
+    /* vkCmdCopyBuffer requires a multiple-of-four byte size. Keep the whole
+     * allocation 16-byte aligned, including a final 1/2/3-component attribute. */
+    size_t tail = (NV2A_VK_SNAPSHOT_ALIGNMENT -
+                   plan.bytes % NV2A_VK_SNAPSHOT_ALIGNMENT) %
+                  NV2A_VK_SNAPSHOT_ALIGNMENT;
+    if (tail > capacity - plan.bytes) {
+        return false;
+    }
+    plan.bytes += tail;
+    /* Keep high-base, narrow index ranges on the original path instead of
+     * copying megabytes of unused prefix just to preserve vertex indices. */
+    if (plan.bytes - useful_bytes > NV2A_VK_SNAPSHOT_PREFIX_LIMIT &&
+        plan.bytes > useful_bytes * 4) {
+        return false;
+    }
+    plan.first = first;
+    plan.last = last;
+    plan.count = count;
+    plan.active = true;
+    *out = plan;
+    return true;
+}
+
+static inline bool nv2a_vk_snapshot_space(size_t used, size_t capacity,
+                                          size_t bytes, size_t *start)
+{
+    if (used > capacity) {
+        return false;
+    }
+    size_t padding = (NV2A_VK_SNAPSHOT_ALIGNMENT -
+                      used % NV2A_VK_SNAPSHOT_ALIGNMENT) %
+                     NV2A_VK_SNAPSHOT_ALIGNMENT;
+    if (padding > capacity - used || bytes > capacity - used - padding) {
+        return false;
+    }
+    *start = used + padding;
+    return true;
+}
+
+/* Caller supplies a validated plan and a nonoverlapping destination of bytes
+ * length. Never change an already allocated snapshot, even for identical data.
+ */
+static inline void nv2a_vk_snapshot_copy(const VertexSnapshot *plan,
+                                        const uint8_t *ram, uint8_t *out)
+{
+    size_t vertices = (size_t)plan->last - plan->first + 1;
+    for (uint32_t i = 0; i < plan->count; i++) {
+        const VertexSnapshotAttribute *a = &plan->attributes[i];
+        size_t source = (size_t)a->source + (size_t)plan->first * a->stride;
+        size_t target = a->offset + (size_t)plan->first * a->width;
+        if (a->stride == a->width) {
+            memcpy(out + target, ram + source, vertices * a->width);
+        } else {
+            for (size_t j = 0; j < vertices; j++) {
+                memcpy(out + target + j * a->width,
+                       ram + source + j * a->stride, a->width);
+            }
+        }
+    }
+}
+#endif
diff --git a/tests/unit/test-nv2a-vk-vertex-snapshot.c b/tests/unit/test-nv2a-vk-vertex-snapshot.c
new file mode 100644
--- /dev/null
+++ b/tests/unit/test-nv2a-vk-vertex-snapshot.c
@@ -0,0 +1,89 @@
+/* Byte-oracle tests for Fix 60. SPDX-License-Identifier: LGPL-2.0-or-later */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "hw/xbox/nv2a/pgraph/vk/vertex-snapshot.h"
+
+/* Do not compile test checks away when testing the production NDEBUG path. */
+#undef assert
+#define assert(x) do { if (!(x)) { fprintf(stderr, "CHECK failed: %s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+static uint32_t seed = 0x60a31f19;
+static uint32_t rnd(void) { seed ^= seed << 13; seed ^= seed >> 17; seed ^= seed << 5; return seed; }
+int main(void)
+{
+    enum { RAM = 262144, SPACE = 131072 };
+    uint8_t *ram = malloc(RAM), *arena = malloc(SPACE), *oracle = malloc(SPACE);
+    assert(ram && arena && oracle);
+    for (size_t i = 0; i < RAM; i++) ram[i] = (uint8_t)rnd();
