+        size_t expected = (used + 15) / 16 * 16;
+        assert(fits == (expected + p.bytes <= SPACE));
+        if (fits) assert(start == expected);
+    }
+    VertexSnapshot p;
+    VertexSnapshotAttribute a[2] = {{.source=0,.stride=4,.width=4,.location=0},
+                                  {.source=8,.stride=4,.width=4,.location=1}};
+    assert(!nv2a_vk_snapshot_plan(&p,NULL,1,0,1,RAM,SPACE));
+    assert(!nv2a_vk_snapshot_plan(&p,a,0,0,1,RAM,SPACE));
+    assert(!nv2a_vk_snapshot_plan(&p,a,17,0,1,RAM,SPACE));
+    assert(!nv2a_vk_snapshot_plan(&p,a,1,2,1,RAM,SPACE));
