+    a[0].stride=0; assert(!nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,SPACE));
+    a[0].stride=4;a[0].width=0; assert(!nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,SPACE));
+    a[0].width=17; assert(!nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,SPACE));
+    a[0].width=3; assert(!nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,3));
+    assert(nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,16) && p.bytes==16);
+    a[0].width=4;a[1].location=0;
+    assert(!nv2a_vk_snapshot_plan(&p,a,2,0,0,RAM,SPACE));
+    a[0].location=16; assert(!nv2a_vk_snapshot_plan(&p,a,1,0,0,RAM,SPACE));
+    size_t start=987;
+    assert(!nv2a_vk_snapshot_space(SIZE_MAX,SIZE_MAX,1,&start));
+    assert(!nv2a_vk_snapshot_space(100,99,0,&start));
+    assert(!nv2a_vk_snapshot_space(SIZE_MAX-8,SIZE_MAX,16,&start));
+    assert(start==987);
+    free(ram);free(arena);free(oracle);
+    puts("PASS: 30000 randomized byte-oracle/layout cases; all widths, unaligned/overlapping strides, sparse locations, nonzero indices, padding, bounds and overflow");
