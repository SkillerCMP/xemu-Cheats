+typedef struct PGRAPHVkState {
+ StorageBuffer storage_buffers[3];
+ VertexSnapshot vertex_snapshot;bool vertex_snapshots_enabled;uint8_t *vertex_snapshot_scratch;
+ uint64_t vertex_snapshot_draws,vertex_snapshot_fallbacks,vertex_snapshot_bytes;
