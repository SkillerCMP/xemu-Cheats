+ unsigned long *uploaded_bitmap;size_t bitmap_size;int allocator,command_buffer;bool in_command_buffer;
+} PGRAPHVkState;
+typedef struct PGRAPHState {PGRAPHVkState *vk_renderer_state;unsigned int draw_arrays_length,inline_elements_length;
