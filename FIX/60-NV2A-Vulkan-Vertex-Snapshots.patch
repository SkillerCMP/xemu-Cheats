+#!/usr/bin/env python3
+"""Compile actual Fix60 planner and renderer helpers against delayed-GPU fixtures.
+This does not run a Vulkan driver or the game. Standard C and stub Vulkan types
+are used. Observation-only calls are removed; separate frozen guards cover them.
+"""
+import argparse
+import pathlib
+import re
+import shlex
+import subprocess
+import tempfile
+
+TOKEN = re.compile(r'/\*[\s\S]*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|[{}]')
+def block(source, signature, suffix=''):
+    begin = source.index(signature)
+    depth = 0
+    opened = False
+    for m in TOKEN.finditer(source, begin):
+        if m.group() == '{': depth += 1; opened = True
+        elif m.group() == '}':
+            depth -= 1
+            if opened and depth == 0:
+                end = m.end()
+                if suffix:
+                    end = source.index(suffix, end) + len(suffix)
+                return source[begin:end]
+    raise ValueError('Unterminated block: '+signature)
+
+def helpers(root):
+    # Match the relevant real signedness instead of assuming uint32_t arrays.
+    state_header=(root/'hw/xbox/nv2a/pgraph/pgraph.h').read_text()
+    for declaration in ['unsigned int inline_elements_length;',
+                        'unsigned int draw_arrays_length;',
+                        'int32_t draw_arrays_start[1250];',
+                        'int32_t draw_arrays_count[1250];']:
+        if declaration not in state_header:
+            raise AssertionError('Update fixture to actual member type: '+declaration)
+    v=(root/'hw/xbox/nv2a/pgraph/vk/vertex.c').read_text()
+    d=(root/'hw/xbox/nv2a/pgraph/vk/draw.c').read_text()
+    result=v[v.index('/* Fix 60: immutable per-draw RAM vertices'):]
+    result+='\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored "-Wsign-compare"\n#pragma GCC diagnostic ignored "-Wunused-parameter"\n'
+    result+='\n'+block(v,'void pgraph_vk_update_vertex_ram_buffer(')
+    for sig in ['static int compare_memory_sync_requirement_by_addr(',
+                'static void sync_vertex_ram_buffer(',
+                'static void get_size_and_count_for_format(']:
+        result+='\n'+block(d,sig)
+    result+='\n'+block(d,'typedef struct VertexBufferRemap', ';')
+    for sig in ['static VertexBufferRemap remap_unaligned_attributes(',
+                'static void copy_remapped_attributes_to_inline_buffer(',
+                'static void bind_vertex_buffer(']:
+        result+='\n'+block(d,sig)
+    result+='\n#pragma GCC diagnostic pop\n'
+    return re.sub(r'xemu_debug_tools_pgraph_draw_trace_(?:stage_begin|stage_end|metric)\s*\([^;]*\);','',result)
+
+def run(cmd):
+    print('+',' '.join(map(str,cmd)),flush=True)
+    subprocess.run(cmd,check=True,timeout=120)
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--root',default='.');ap.add_argument('--compiler',default='cc');ap.add_argument('--sanitize',action='store_true');ap.add_argument('--ndebug',action='store_true');ap.add_argument('--negative',action='store_true');a=ap.parse_args()
+    root=pathlib.Path(a.root).resolve();td=root/'tests/unit'
+    # Fixtures are adjacent to this script, independent of the optional Debug Tools.
+    fixture=(td/'nv2a-vk-vertex-snapshot-fixture.h').read_text()
+    test=(td/'nv2a-vk-vertex-snapshot-fixture.c').read_text()
+    code=helpers(root)
+    cc=shlex.split(a.compiler);flags=['-std=gnu11','-Wall','-Wextra','-Werror','-O2','-I',str(root)]
+    if a.sanitize: flags+=['-g','-O1','-fsanitize=address,undefined','-fno-omit-frame-pointer']
+    if a.ndebug: flags+=['-DNDEBUG']
+    with tempfile.TemporaryDirectory(prefix='xemu-fix60-test-') as t:
+        temp=pathlib.Path(t)
+        binary=temp/'planner'
+        run(cc+flags+[str(td/'test-nv2a-vk-vertex-snapshot.c'),'-o',str(binary)]);run([str(binary)])
+        source=temp/'integration.c';source.write_text(fixture+'\n'+code+'\n'+test)
+        binary=temp/'integration'
+        run(cc+flags+[str(source),'-o',str(binary)]);run([str(binary)])
+        lifecycle = (root/'hw/xbox/nv2a/pgraph/vk/buffer.c').read_text()
+        lifecycle = lifecycle.replace('#include "renderer.h"', '')
+        lc_source = temp/'lifecycle.c'
+        lc_source.write_text((td/'nv2a-vk-vertex-snapshot-lifecycle.h').read_text()+
+                             '\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored "-Wsign-compare"\n' +
+                             '#pragma GCC diagnostic ignored "-Wunused-but-set-variable"\n'+
+                             lifecycle+'\n#pragma GCC diagnostic pop\n'+
+                             (td/'nv2a-vk-vertex-snapshot-lifecycle.c').read_text())
+        lc_binary = temp/'lifecycle'
+        run(cc+flags+[str(lc_source),'-o',str(lc_binary)]);run([str(lc_binary)])
+        if a.negative:
+            mutants={
+                'discard previous arena versions':code.replace('    memcpy(buffer->mapped + start, r->vertex_snapshot_scratch, plan->bytes);','    start = 0;\n    memcpy(buffer->mapped + start, r->vertex_snapshot_scratch, plan->bytes);'),
+                'read guest bytes too late':code.replace('    memcpy(buffer->mapped + start, r->vertex_snapshot_scratch, plan->bytes);','    nv2a_vk_snapshot_copy(plan, d->vram_ptr, buffer->mapped + start);'),
+                'trust stale dirty flag on fallback':code.replace('        pgraph_vk_invalidate_vertex_snapshot_mirror(d);', ''),
+                'omit noncoherent flush':code.replace('VK_CHECK(vmaFlushAllocation(r->allocator, buffer->allocation, start, plan->bytes));','(void)vmaFlushAllocation;'),
+            }
+            for name,mutant in mutants.items():
+                if mutant==code: raise AssertionError('no mutation: '+name)
+                source.write_text(fixture+'\n'+mutant+'\n'+test)
+                run(cc+flags+[str(source),'-o',str(binary)])
+                p=subprocess.run([str(binary)],capture_output=True,timeout=120)
+                if p.returncode==0: raise AssertionError('unsafe mutant accepted: '+name)
+                print('PASS: rejected unsafe negative control:',name,flush=True)
+    return 0
+if __name__=='__main__':raise SystemExit(main())
